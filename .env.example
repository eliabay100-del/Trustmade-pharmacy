# Copy this file to .env, then run: composer install && npm ci && php artisan key:generate
APP_NAME=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# The pharmacy is in Addis Ababa (UTC+3); without this the "due today" reminders
# and till-day cut-offs are calculated on UTC.
APP_TIMEZONE=Africa/Addis_Ababa

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pmas
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# First administrator created by the seeders. Change the password after the
# first login. In production leave ADMIN_PASSWORD blank and the seeder will
# generate a strong one and print it once.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@pmas.com
ADMIN_PASSWORD=password

# Nightly database backups (php artisan pmas:backup): how many files to keep.
BACKUP_KEEP=14

# Only needed behind a reverse proxy / load balancer (comma-separated IPs, or
# "*" to trust all). Leave blank when PHP serves requests directly.
TRUSTED_PROXIES=
