# ---------------------------------------------------------------------------
# TRUSTMED PHARMACY - production environment template
# ---------------------------------------------------------------------------
#
# Copy to .env on the server and edit. Never commit the real file.
#
#   cp .env.production.example .env
#   php artisan key:generate --force
#   php artisan optimize
#   php artisan pmas:preflight
#
# The preflight command checks this file for you. Run it before the site is
# announced to anyone - it is far faster to find a problem there than in a
# customer's browser.
# ---------------------------------------------------------------------------

# "TRUSTMED" is the host name. It drives documentation and cache-busting only;
# Laravel reads the live host from each request, so renaming the site later
# does not require a code change.
TRUSTMED_DOMAIN=trustmed.pharmacy.et

# NO TRAILING SLASH on APP_URL. The trailing slash is the single most common
# cause of "every link is broken" after a deploy.
APP_NAME="TRUSTMED Pharmacy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://trustmed.pharmacy.et

# English throughout. Date and number formatting follow this, so an unset value
# here would quietly fall back to whatever the framework guesses.
APP_LOCALE=en

# Addis Ababa is UTC+3. Without this, "due today" reminders and the till
# day-end cut-off are calculated three hours out.
APP_TIMEZONE=Africa/Addis_Ababa

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# "debug" writes every query and deprecation to laravel.log. On shared hosting
# that fills the disk; start at "info" and only drop to "warning" if needed.
LOG_LEVEL=info
# Laravel writes one log file per day; this caps how many are kept.
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trustmed
DB_USERNAME=
DB_PASSWORD=

# Shared hosting: file-backed everything. No Redis or Memcached is assumed,
# because the alternatives fail in ways that are hard to diagnose from inside
# a control panel.
BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# 120 minutes: long enough for a slow shift, short enough that an abandoned
# till does not stay open on the books overnight.
SESSION_DRIVER=file
SESSION_LIFETIME=120

# The site is HTTPS only, so the cookie must be HTTPS only. Leaving this false
# sends the session cookie in clear text on every request.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Leave SESSION_DOMAIN empty unless staff must stay signed in across subdomains.
# Setting it wrongly - to localhost, for example - breaks every login.
SESSION_DOMAIN=

# Anything that terminates the connection in front of PHP: the host's proxy, a
# CDN, or the control panel's own front end. Without this, requests look like
# plain http and the HTTPS redirect in SecurityHeaders loops forever.
#
# Find it: open a PHP file that prints $_SERVER['REMOTE_ADDR'], or check the
# access log for the address requests arrive from. Prefer one IP.
# Use "*" only if nothing untrusted can reach PHP directly.
TRUSTED_PROXIES=

# First administrator created by the seeders. Staff sign in with a username,
# so ADMIN_USERNAME is what is typed at the login screen; the email is kept on
# the account for records.
#
# In production leave ADMIN_PASSWORD blank: the seeder generates a strong one
# and prints it exactly once. If you set it here, it stays in this file.
ADMIN_NAME="Trust Med Pharmacy"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nightly backups (php artisan pmas:backup). These land in
# storage/app/private/backups, which is NOT web-reachable.
BACKUP_KEEP=14

# Copy them off the machine. A backup that only exists on the box it protects
# is lost the moment the box dies.
#BACKUP_COPY_DEST=/home/youruser/pmas-backups

# Vendor credit in the app chrome ("by ..." on the login page).
VENDOR_NAME="AMBA Solutions"
VENDOR_URL=https://amba.site.je
