# Hosting template — copy to .env on the machine that will serve the app.
# Keep .env out of git; only .env.example files are committed.
# Setup after copying this file: composer install --no-dev --optimize-autoloader,
# npm ci && npm run build, php artisan key:generate, php artisan migrate --force,
# php artisan storage:link, php artisan optimize.
# Add the scheduler cron so session GC and cache pruning run automatically:
#   * * * * * cd /path/to/project && php artisan schedule:run >> /dev/null 2>&1
APP_NAME=PMAS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people type to reach this machine.
APP_URL=http://trustmade.test

# The reminders and till-day cut-offs use the app timezone; the pharmacy is in Addis Ababa.
APP_TIMEZONE=Africa/Addis_Ababa
APP_LOCALE=en

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pmas
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Left false because this host is served over plain http on the local network.
SESSION_SECURE_COOKIE=false
